rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CDS DRIVING SCHOOL - SECURITY RULES
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaff() {
      return isSignedIn() && getUserData().role in ['Admin', 'BranchManager', 'Instructor'];
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'Admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isStaff();
      allow create, update: if isOwner(userId) || isStaff();
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      allow list: if isStaff() || (isSignedIn() && resource.data.studentUid == request.auth.uid) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow get: if isStaff() || (isSignedIn() && resource.data.studentUid == request.auth.uid) || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isStaff();
    }

    match /instructors/{instructorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /attendance/{id} {
      allow list: if isStaff() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow get: if isStaff() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow write: if isStaff();
    }

    match /payments/{paymentId} {
      allow list: if isStaff() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow get: if isStaff() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow write: if isStaff();
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /expenses/{expenseId} {
      allow read, write: if isStaff();
    }

    match /courses/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /resources/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /quizLinks/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read, write: if isAdmin();
    }

    match /backupMetadata/{id} {
      allow read, write: if isAdmin();
    }
  }
}