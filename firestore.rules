
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    // Safely get the user document data for the current authenticated user
    function getProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getProfile().role == role;
    }

    function isAdmin() {
      return hasRole('Admin');
    }

    function isBranchManager() {
      return hasRole('BranchManager');
    }

    function isStaff() {
      return isAdmin() || isBranchManager();
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      // Allow any signed in user to get a user doc (needed for role checks)
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isBranchManager());
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /students/{studentId} {
      // Staff can list students. In practice, the query filters by branch.
      allow list: if isSignedIn() && (isAdmin() || isBranchManager());
      
      allow get: if isSignedIn() && (
        isAdmin() || 
        isBranchManager() || 
        (resource != null && resource.data.userId == request.auth.uid) ||
        (request.auth.uid == studentId)
      );
      
      allow create, update: if isAdmin() || isBranchManager();
      allow delete: if isAdmin();
    }

    match /instructors/{instructorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isBranchManager();
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isBranchManager();
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isBranchManager() || hasRole('Instructor');
    }

    match /attendance/{attendanceId} {
      allow list: if isSignedIn() && (isAdmin() || isBranchManager() || hasRole('Instructor'));
      allow get: if isSignedIn();
      allow write: if isAdmin() || isBranchManager();
    }

    match /payments/{paymentId} {
      allow list: if isSignedIn() && (isAdmin() || isBranchManager() || hasRole('Accountant'));
      allow get: if isSignedIn();
      allow write: if isAdmin() || isBranchManager() || hasRole('Accountant');
    }

    match /expenses/{expenseId} {
      allow list: if isSignedIn() && (isAdmin() || isBranchManager() || hasRole('Accountant'));
      allow get: if isSignedIn();
      allow write: if isAdmin() || isBranchManager() || hasRole('Accountant');
    }

    match /backupMetadata/{backupId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }
  }
}
