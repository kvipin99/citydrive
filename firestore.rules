
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * DRIVING SCHOOL MANAGEMENT SYSTEM - SECURITY RULES
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('Admin');
    }

    function isBranchManager() {
      return hasRole('BranchManager');
    }

    function isInstructor() {
      return hasRole('Instructor');
    }

    function isStaff() {
      return isAdmin() || isBranchManager() || isInstructor();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** 
     * Verifies if a record belongs to the student user.
     * Checks the user's profile for the business studentId.
     */
    function isStudentRecord(studentId) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData().studentId == studentId;
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isStaff();
      allow create, update: if isOwner(userId) || isStaff();
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isStaff() || isStudentRecord(studentId);
      allow write: if isStaff();
    }

    match /attendance/{id} {
      allow read: if isStaff() || isStudentRecord(resource.data.studentId);
      allow write: if isStaff();
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isBranchManager();
    }

    match /payments/{paymentId} {
      allow read: if isStaff() || isStudentRecord(resource.data.studentId);
      allow write: if isAdmin() || isBranchManager();
    }

    match /expenses/{expenseId} {
      allow read, write: if isAdmin() || isBranchManager();
    }

    match /courses/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /resources/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /quizzes/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /quizAttempts/{id} {
      allow read: if isSignedIn() && (isStaff() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /settings/{id} {
      allow read, write: if isAdmin();
    }

    match /backupMetadata/{id} {
      allow read, write: if isAdmin();
    }
  }
}
