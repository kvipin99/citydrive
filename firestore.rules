
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasRole(role) {
      return isSignedIn() && getRole() == role;
    }

    function isAdmin() {
      return hasRole('Admin');
    }

    function isBranchManager() {
      return hasRole('BranchManager');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      // Allow Branch Managers to create student/staff profiles during registration
      // and allow users to update their own profiles (like avatars)
      allow create, update: if isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin() || 
        isBranchManager()
      );
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isSignedIn() && (isOwner(studentId) || isAdmin() || isBranchManager());
      allow create, update: if isAdmin() || isBranchManager();
      allow delete: if isAdmin();
    }

    match /instructors/{instructorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isBranchManager();
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isBranchManager();
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isBranchManager() || hasRole('Instructor');
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isBranchManager() || hasRole('Accountant');
    }

    match /expenses/{expenseId} {
      allow read, write: if isAdmin() || isBranchManager() || hasRole('Accountant');
    }

    match /backupMetadata/{backupId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }
  }
}
