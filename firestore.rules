
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getProfile().role == 'Admin';
    }

    function isBranchManager() {
      return isSignedIn() && getProfile().role == 'BranchManager';
    }

    function isStaff() {
      return isAdmin() || isBranchManager();
    }

    function isStudent() {
      return isSignedIn() && getProfile().role == 'Student';
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isBranchManager());
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /students/{studentId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /instructors/{instructorId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isStaff() || getProfile().role == 'Instructor';
    }

    match /attendance/{attendanceId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow write: if isStaff();
    }

    match /payments/{paymentId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow write: if isStaff();
    }

    match /expenses/{expenseId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow write: if isStaff();
    }

    match /backupMetadata/{backupId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }
  }
}
