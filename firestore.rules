
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    // Safely get the user document data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('Admin');
    }

    function isBranchManager() {
      return hasRole('BranchManager');
    }

    function isAccountant() {
      return hasRole('Accountant');
    }

    function isInstructor() {
      return hasRole('Instructor');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isBranchManager());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin() || 
        isBranchManager()
      );
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /students/{studentId} {
      // Staff can list and get student details
      allow list: if isSignedIn() && (isAdmin() || isBranchManager());
      allow get: if isSignedIn() && (
        isAdmin() || 
        isBranchManager() || 
        (resource != null && resource.data.userId == request.auth.uid) ||
        (request.auth.uid == studentId)
      );
      
      allow create, update: if isAdmin() || isBranchManager();
      allow delete: if isAdmin();
    }

    match /instructors/{instructorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isBranchManager();
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isBranchManager();
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isBranchManager() || isInstructor();
    }

    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && (isAdmin() || isBranchManager() || isInstructor());
      allow write: if isAdmin() || isBranchManager();
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (isAdmin() || isBranchManager() || isAccountant());
      allow write: if isAdmin() || isBranchManager() || isAccountant();
    }

    match /expenses/{expenseId} {
      allow read: if isSignedIn() && (isAdmin() || isBranchManager() || isAccountant());
      allow write: if isAdmin() || isBranchManager() || isAccountant();
    }

    match /backupMetadata/{backupId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }
  }
}
