rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * DRIVING SCHOOL MANAGEMENT SYSTEM - SECURITY RULES
     *
     * Core Philosophy:
     * This ruleset enforces a strict Role-Based Access Control (RBAC) model combined with document-level ownership.
     * High-level roles (Admin, Instructor, Accountant) are stored in the /users collection and checked via helper functions.
     *
     * Data Structure:
     * - /users: Profiles and roles for application users.
     * - /students: Detailed records of enrolled students. Linked to instructors via 'assignedInstructorId'.
     * - /instructors: Profiles for driving instructors.
     * - /vehicles: Operational data for the school's fleet.
     * - /classes: Scheduled lessons linking students and instructors.
     * - /payments: Financial records for student fees.
     * - /expenses: Internal school operating costs.
     * - /backups: Metadata for data backups, restricted to Admins.
     *
     * Key Security Decisions:
     * - Authorization Independence: Critical IDs (e.g., studentId, instructorId) are denormalized onto documents 
     *   to allow fast, queryable security checks without expensive cross-collection lookups.
     * - Prototyping Flexibility: Rules strictly enforce 'who' can perform an action, but remain flexible on the 
     *   internal data schema (beyond essential ID and ownership fields) to allow for rapid UI/UX iteration.
     * - RBAC: Roles are retrieved from the user's document in the /users collection.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    /** Checks if a user is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Retrieves the role of the authenticated user from their profile. */
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    /** Checks if the authenticated user has a specific role. */
    function hasRole(role) {
      return isSignedIn() && getRole() == role;
    }

    /** Checks if the user is an Admin. */
    function isAdmin() {
      return hasRole('Admin');
    }

    /** Checks if the user is an Accountant. */
    function isAccountant() {
      return hasRole('Accountant');
    }

    /** Checks if the user is an Instructor. */
    function isInstructor() {
      return hasRole('Instructor');
    }

    /** Basic ownership check based on UID. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Combined ownership and existence check for updates and deletes. */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for the User collection. Owners can manage their own profile; Admins manage all.
     * @path /users/{userId}
     * @allow (get) If user is owner or Admin.
     * @deny (create) If userId in path does not match auth UID or creatorId.
     * @principle Verifies path consistency and enforces ownership/role-based access.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if (isExistingOwner(userId) || isAdmin()) && request.resource.data.id == resource.data.id;
      allow delete: if isAdmin();
    }

    /**
     * @description Students records. Admins/Accountants manage; Instructors read assigned students.
     * @path /students/{studentId}
     * @allow (list) If user is Admin, Accountant, or Instructor (with query filter).
     * @deny (update) If user is not an Admin.
     * @principle Uses denormalized assignedInstructorId for instructor read access.
     */
    match /students/{studentId} {
      allow get: if isAdmin() || isAccountant() || (isInstructor() && resource.data.assignedInstructorId == request.auth.uid);
      allow list: if isAdmin() || isAccountant() || isInstructor();
      allow create: if isAdmin() && request.resource.data.id == studentId;
      allow update: if isAdmin() && resource != null && request.resource.data.id == resource.data.id;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Instructor profiles. Instructors can view/edit themselves; Admins manage all.
     * @path /instructors/{instructorId}
     * @allow (update) If user is the instructor owner.
     * @deny (delete) If user is not an Admin.
     * @principle Standard ownership pattern for staff profiles.
     */
    match /instructors/{instructorId} {
      allow get: if isAdmin() || isOwner(instructorId);
      allow list: if isAdmin() || isInstructor();
      allow create: if isAdmin() || isOwner(instructorId);
      allow update: if (isAdmin() || isExistingOwner(instructorId)) && request.resource.data.id == resource.data.id;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Vehicle inventory. Public read for all school staff; Admin-only writes.
     * @path /vehicles/{vehicleId}
     * @allow (list) If user is signed in.
     * @deny (create) If user is not an Admin.
     * @principle Restricts fleet management to administrative roles.
     */
    match /vehicles/{vehicleId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && resource != null;
    }

    /**
     * @description Class schedules. Admins manage; Instructors/Students see their specific classes.
     * @path /classes/{classId}
     * @allow (get) If user is Admin, or the assigned instructor or student.
     * @deny (update) If user is not the Admin or assigned instructor.
     * @principle Relies on denormalized studentId and instructorId for authorization.
     */
    match /classes/{classId} {
      allow get: if isAdmin() || (isSignedIn() && (resource.data.instructorId == request.auth.uid || resource.data.studentId == request.auth.uid));
      allow list: if isSignedIn();
      allow create: if isAdmin() || (isInstructor() && request.resource.data.instructorId == request.auth.uid);
      allow update: if (isAdmin() || (isInstructor() && resource != null && resource.data.instructorId == request.auth.uid));
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Payment records. Admins and Accountants manage; Students view their own history.
     * @path /payments/{paymentId}
     * @allow (list) If user is Admin, Accountant, or the student linked to the payment.
     * @deny (create) If user is not Admin or Accountant.
     * @principle Financial integrity restricted to specific financial roles.
     */
    match /payments/{paymentId} {
      allow get: if isAdmin() || isAccountant() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow list: if isAdmin() || isAccountant() || (isSignedIn());
      allow create: if isAdmin() || isAccountant();
      allow update, delete: if (isAdmin() || isAccountant()) && resource != null;
    }

    /**
     * @description School operational expenses. Accessible only by financial staff.
     * @path /expenses/{expenseId}
     * @allow (create) If user is Admin or Accountant.
     * @deny (get) If user is a standard Instructor or Student.
     * @principle Protects sensitive business expenditure data.
     */
    match /expenses/{expenseId} {
      allow get, list: if isAdmin() || isAccountant();
      allow create: if isAdmin() || isAccountant();
      allow update, delete: if (isAdmin() || isAccountant()) && resource != null;
    }

    /**
     * @description Metadata for system backups.
     * @path /backups/{backupId}
     * @allow (all) Only if user is an Admin.
     * @deny (get) For all non-admin roles.
     * @principle Strict Admin-only lockdown for system maintenance records.
     */
    match /backups/{backupId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && resource != null;
    }
  }
}