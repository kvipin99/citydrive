
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'Admin';
    }

    function isBranchManager() {
      return isSignedIn() && getUserData().role == 'BranchManager';
    }

    function isStaff() {
      let role = getUserData().role;
      return isSignedIn() && (role == 'Admin' || role == 'BranchManager');
    }

    function isStudent() {
      return isSignedIn() && getUserData().role == 'Student';
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /students/{studentId} {
      // Allow read if user is staff (isolation handled by queries) or if the student record belongs to the user
      allow read: if isSignedIn() && (isStaff() || (isStudent() && resource.data.userId == request.auth.uid));
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /instructors/{instructorId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isStaff() || getUserData().role == 'Instructor';
    }

    match /attendance/{attendanceId} {
      // Allow listing for staff. Students should query with studentId filter.
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /backupMetadata/{backupId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }
  }
}
