
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * DRIVING SCHOOL MANAGEMENT SYSTEM - SECURITY RULES
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('Admin');
    }

    function isBranchManager() {
      return hasRole('BranchManager');
    }

    function isInstructor() {
      return hasRole('Instructor');
    }

    function isStudent() {
      return hasRole('Student');
    }

    function isStaff() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData().role in ['Admin', 'BranchManager', 'Instructor'];
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isStaff();
      allow create, update: if isOwner(userId) || isStaff();
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      // Allow students to read their own record via userId field
      allow read: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isStaff();
    }

    match /attendance/{id} {
      // Split list and get for clearer optimization
      allow list: if isStaff() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow get: if isStaff() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow write: if isStaff();
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isBranchManager();
    }

    match /payments/{paymentId} {
      allow list: if isStaff() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow get: if isStaff() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow write: if isAdmin() || isBranchManager();
    }

    match /expenses/{expenseId} {
      allow read, write: if isAdmin() || isBranchManager();
    }

    match /courses/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /resources/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /quizzes/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /quizAttempts/{id} {
      // Optimized for list queries using studentUid
      allow list: if isStaff() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow get: if isStaff() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /settings/{id} {
      allow read, write: if isAdmin();
    }

    match /backupMetadata/{id} {
      allow read, write: if isAdmin();
    }
  }
}
