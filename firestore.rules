
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(profilePath) && get(profilePath).data.role == role;
    }

    function isAdmin() {
      return hasRole('Admin');
    }

    function isBranchManager() {
      return hasRole('BranchManager');
    }

    function isInstructor() {
      return hasRole('Instructor');
    }

    function isStaff() {
      return isAdmin() || isBranchManager() || isInstructor();
    }

    function isStudent() {
      return hasRole('Student');
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow list: if isStaff();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /students/{studentId} {
      allow get: if isSignedIn() && (isStaff() || (isStudent() && resource.data.userId == request.auth.uid));
      allow list: if isSignedIn() && (isStaff() || isStudent());
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /instructors/{instructorId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /attendance/{attendanceId} {
      allow get: if isSignedIn() && (isStaff() || (isStudent() && resource.data.studentId != null));
      allow list: if isSignedIn() && (isStaff() || isStudent());
      allow write: if isStaff();
    }

    match /payments/{paymentId} {
      allow get: if isSignedIn() && (isStaff() || (isStudent() && resource.data.studentId != null));
      allow list: if isSignedIn() && (isStaff() || isStudent());
      allow write: if isStaff();
    }

    match /expenses/{expenseId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /backupMetadata/{backupId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }
  }
}
