
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user account within the system, linked to Firebase Authentication.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "branch": { "type": "string" },
        "studentId": { "type": "string" },
        "staffId": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "role"]
    },
    "Student": {
      "title": "Student",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "branch": { "type": "string" },
        "registrationDate": { "type": "string", "format": "date" },
        "status": { "type": "string" },
        "amount": { "type": "number" },
        "payments": { "type": "array" },
        "studentUid": { "type": "string" },
        "specialCourseName": { "type": "string", "description": "Custom name for 'Others' course selection." },
        "specialCourseFee": { "type": "number", "description": "Custom fee for 'Others' course selection." },
        "learnersNo": { "type": "string", "description": "Learners license identification number." },
        "drivingNo": { "type": "string", "description": "Permanent driving license identification number." }
      }
    },
    "Instructor": {
      "title": "Instructor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Deactive"] },
        "avatarUrl": { "type": "string" }
      }
    },
    "Vehicle": {
      "title": "Vehicle",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "regNumber": { "type": "string" },
        "brandModel": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "Attendance": {
      "title": "Attendance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentUid": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "type": { "type": "string" },
        "branch": { "type": "string" }
      }
    },
    "Class": {
      "title": "Class",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "instructorId": { "type": "string" },
        "startTime": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "Payment": {
      "title": "Payment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentUid": { "type": "string" },
        "amount": { "type": "number" },
        "receiptNo": { "type": "string" }
      }
    },
    "Expense": {
      "title": "Expense",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" }
      }
    },
    "Course": {
      "title": "Course",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "amount": { "type": "number" }
      }
    },
    "Resource": {
      "title": "Resource",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "QuizLink": {
      "title": "Quiz Link",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "url": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      { "path": "/users/{userId}", "definition": { "entityName": "User" } },
      { "path": "/students/{studentId}", "definition": { "entityName": "Student" } },
      { "path": "/instructors/{instructorId}", "definition": { "entityName": "Instructor" } },
      { "path": "/attendance/{id}", "definition": { "entityName": "Attendance" } },
      { "path": "/vehicles/{vehicleId}", "definition": { "entityName": "Vehicle" } },
      { "path": "/payments/{paymentId}", "definition": { "entityName": "Payment" } },
      { "path": "/expenses/{expenseId}", "definition": { "entityName": "Expense" } },
      { "path": "/courses/{id}", "definition": { "entityName": "Course" } },
      { "path": "/classes/{id}", "definition": { "entityName": "Class" } },
      { "path": "/resources/{id}", "definition": { "entityName": "Resource" } },
      { "path": "/quizLinks/{id}", "definition": { "entityName": "QuizLink" } },
      { "path": "/settings/{id}", "definition": { "description": "System configuration settings." } },
      { "path": "/backupMetadata/{id}", "definition": { "description": "Audit logs for database exports." } }
    ]
  }
}
