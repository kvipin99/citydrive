
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user account within the system, linked to Firebase Authentication and assigned a specific role for access control.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity (UID)."
        },
        "name": {
          "type": "string",
          "description": "Display name of the user."
        },
        "role": {
          "type": "string",
          "description": "The assigned role (Admin, BranchManager, Instructor, Student)."
        },
        "branch": {
          "type": "string",
          "description": "The branch the user belongs to."
        },
        "studentId": {
          "type": "string",
          "description": "The business ID if the user is a student (e.g. B10001)."
        }
      },
      "required": [
        "id",
        "role"
      ]
    },
    "Student": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Student",
      "type": "object",
      "description": "Represents a student enrolled in the driving school.",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string",
          "description": "The Firebase Authentication UID of the student."
        },
        "name": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "registrationDate": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        },
        "payments": {
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "branch",
        "status",
        "userId"
      ]
    },
    "Attendance": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Attendance",
      "type": "object",
      "description": "Represents a training session log entry.",
      "properties": {
        "id": {
          "type": "string"
        },
        "studentId": {
          "type": "string"
        },
        "studentUid": {
          "type": "string",
          "description": "The Firebase Authentication UID of the student for security rules."
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "type": {
          "type": "string",
          "enum": [
            "Practical",
            "Theory"
          ]
        },
        "duration": {
          "type": "number"
        },
        "vehicleReg": {
          "type": "string"
        }
      },
      "required": [
        "studentId",
        "studentUid",
        "date"
      ]
    },
    "Course": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Course",
      "type": "object",
      "description": "Represents a course offered by the school.",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        }
      },
      "required": [
        "name",
        "amount"
      ]
    },
    "Resource": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Resource",
      "type": "object",
      "description": "Learning materials like videos or PDFs.",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "Video",
            "PDF",
            "Link"
          ]
        },
        "url": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "type",
        "url"
      ]
    },
    "Quiz": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Quiz",
      "type": "object",
      "description": "Examination provided by Admin.",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "timeLimit": {
          "type": "number",
          "description": "Time limit in minutes."
        },
        "passingMarks": {
          "type": "number"
        },
        "questions": {
          "type": "array"
        }
      },
      "required": [
        "title",
        "questions"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User"
        }
      },
      {
        "path": "/students/{studentId}",
        "definition": {
          "entityName": "Student"
        }
      },
      {
        "path": "/attendance/{id}",
        "definition": {
          "entityName": "Attendance"
        }
      },
      {
        "path": "/courses/{id}",
        "definition": {
          "entityName": "Course"
        }
      },
      {
        "path": "/resources/{id}",
        "definition": {
          "entityName": "Resource"
        }
      },
      {
        "path": "/quizzes/{id}",
        "definition": {
          "entityName": "Quiz"
        }
      },
      {
        "path": "/quizAttempts/{id}",
        "definition": {
          "description": "Records of student quiz performances."
        }
      },
      {
        "path": "/settings/{id}",
        "definition": {
          "description": "System configuration settings."
        }
      }
    ]
  }
}
