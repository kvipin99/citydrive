{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user in the system with their authentication ID, email, and assigned role.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity, typically the Firebase Authentication User ID (UID)."
        },
        "email": {
          "type": "string",
          "description": "The email address associated with the user's account.",
          "format": "email"
        },
        "role": {
          "type": "string",
          "description": "The role of the user within the system (e.g., Admin, Instructor, Accountant, BranchManager)."
        },
        "branch": {
          "type": "string",
          "description": "The branch assigned to the user."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the user record was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when the user record was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "email",
        "role",
        "createdAt",
        "updatedAt"
      ]
    },
    "Course": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Course",
      "type": "object",
      "description": "Represents a driving course offered by the school.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the course."
        },
        "name": {
          "type": "string",
          "description": "The name of the course."
        },
        "amount": {
          "type": "number",
          "description": "The standard fee for this course."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "amount"
      ]
    },
    "Student": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Student",
      "type": "object",
      "description": "Represents a student enrolled in the driving school.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "branch": { "type": "string" },
        "address": { "type": "string" },
        "parentName": { "type": "string" },
        "aadharNo": { "type": "string" },
        "onlineAppNo": { "type": "string" },
        "learnersDate": { "type": "string", "format": "date" },
        "testDate": { "type": "string", "format": "date" },
        "remarks": { "type": "string" },
        "photoUrl": { "type": "string" },
        "courses": { "type": "array", "items": { "type": "string" } },
        "specialCourseName": { "type": "string" },
        "specialCourseFee": { "type": "number" },
        "amount": { "type": "number" },
        "discount": { "type": "number" },
        "status": { "type": "string" },
        "registrationDate": { "type": "string", "format": "date" },
        "payments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "amount": { "type": "number" },
              "date": { "type": "string", "format": "date-time" },
              "receiptNo": { "type": "string" },
              "method": { "type": "string" }
            }
          }
        }
      }
    },
    "Instructor": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Instructor",
      "type": "object",
      "description": "Represents a staff member or instructor at the driving school.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Deactive"] },
        "avatarUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "name", "phone", "status"]
    },
    "Payment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Payment",
      "type": "object",
      "description": "Represents a single payment transaction received from a student.",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentPhone": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "receiptNo": { "type": "string" },
        "method": { "type": "string", "enum": ["Cash", "Online", "Cheque"] },
        "receivedBy": { "type": "string" },
        "branch": { "type": "string" }
      },
      "required": ["id", "studentId", "amount", "date", "receiptNo", "method"]
    },
    "Expense": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Expense",
      "type": "object",
      "description": "Represents a business expense incurred by the school or a branch.",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "category": { "type": "string", "enum": ["Fuel", "Salaries", "Maintenance", "Rent", "Utility", "Others"] },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "branch": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "date", "category", "amount", "branch"]
    },
    "Class": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Class",
      "type": "object",
      "description": "Represents a scheduled driving lesson.",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "instructorId": { "type": "string" },
        "instructorName": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Scheduled", "Completed", "Canceled"] },
        "notes": { "type": "string" }
      },
      "required": ["id", "studentId", "instructorId", "startTime", "endTime", "status"]
    },
    "Attendance": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Attendance",
      "type": "object",
      "description": "Represents a record of student attendance for a driving session.",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["Present", "Absent"] },
        "startTime": { "type": "string", "description": "Session start time (HH:mm)" },
        "endTime": { "type": "string", "description": "Session end time (HH:mm)" },
        "duration": { "type": "number", "description": "Duration in hours" },
        "branch": { "type": "string" },
        "remarks": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "studentId", "date", "status", "branch"]
    },
    "BackupMetadata": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "BackupMetadata",
      "type": "object",
      "description": "Audit logs for data export operations.",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "performedBy": { "type": "string" },
        "status": { "type": "string" },
        "type": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "User profiles and roles."
        }
      },
      {
        "path": "/courses/{courseId}",
        "definition": {
          "entityName": "Course",
          "schema": { "$ref": "#/backend/entities/Course" },
          "description": "Master list of courses and pricing."
        }
      },
      {
        "path": "/students/{studentId}",
        "definition": {
          "entityName": "Student",
          "schema": { "$ref": "#/backend/entities/Student" },
          "description": "Student enrollment data."
        }
      },
      {
        "path": "/instructors/{instructorId}",
        "definition": {
          "entityName": "Instructor",
          "schema": { "$ref": "#/backend/entities/Instructor" },
          "description": "Staff and instructor records."
        }
      },
      {
        "path": "/payments/{paymentId}",
        "definition": {
          "entityName": "Payment",
          "schema": { "$ref": "#/backend/entities/Payment" },
          "description": "Records of all received payments."
        }
      },
      {
        "path": "/expenses/{expenseId}",
        "definition": {
          "entityName": "Expense",
          "schema": { "$ref": "#/backend/entities/Expense" },
          "description": "Business expense records."
        }
      },
      {
        "path": "/classes/{classId}",
        "definition": {
          "entityName": "Class",
          "schema": { "$ref": "#/backend/entities/Class" },
          "description": "Scheduled driving lessons and attendance."
        }
      },
      {
        "path": "/attendance/{attendanceId}",
        "definition": {
          "entityName": "Attendance",
          "schema": { "$ref": "#/backend/entities/Attendance" },
          "description": "Daily student attendance records."
        }
      },
      {
        "path": "/backupMetadata/{backupId}",
        "definition": {
          "entityName": "BackupMetadata",
          "schema": { "$ref": "#/backend/entities/BackupMetadata" },
          "description": "Audit logs for backups."
        }
      }
    ]
  }
}
